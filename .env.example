# Referência para as variáveis de ambiente do processo. Use dados fictícios.
CONEXAO_DP_DB=dados/demo.sqlite3
CONEXAODP_PYTHON_ORIGIN=http://127.0.0.1:8792

# Clicksign opcional. Mantenha o token vazio na demonstração.
CLICKSIGN_API_ENVIRONMENT=sandbox
CLICKSIGN_API_TOKEN=

# SMTP, Z-PRO, Selecty, VoxFy e SIB Bridge têm configuração na interface.
